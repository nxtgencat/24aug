# Optional integrations — the app runs fully without them (mock fallbacks).
# Copy to .env and fill in only what you use.

# Cloudinary (file uploads in Lab Reports / Records)
VITE_CLOUDINARY_URL=

# EmailJS (Notifications → "Email digest" button actually sends when set)
VITE_EMAILJS_SERVICE=
VITE_EMAILJS_TEMPLATE=
VITE_EMAILJS_PUBLIC_KEY=
